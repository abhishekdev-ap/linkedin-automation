# LinkedIn Automation Tool Environment Configuration
# Copy this file to .env and fill in your values

# LinkedIn Credentials (Required)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Browser Configuration
HEADLESS=false                    # Run browser in headless mode (true/false)
BROWSER_PATH=                     # Custom browser path (leave empty for default)

# Debugging
DEBUG=false                       # Enable debug logging
SCREENSHOT_ON_ERROR=true          # Take screenshot when errors occur

# Stealth Configuration
MIN_DELAY_MS=500                  # Minimum delay between actions (ms)
MAX_DELAY_MS=3000                 # Maximum delay between actions (ms)

# Rate Limiting
DAILY_CONNECTION_LIMIT=50         # Maximum connections per day
HOURLY_CONNECTION_LIMIT=10        # Maximum connections per hour
DAILY_MESSAGE_LIMIT=100           # Maximum messages per day

# Session
SESSION_FILE=.session.json        # Path to session file for cookie persistence

# Database
DB_PATH=linkedin_automation.db    # SQLite database path
