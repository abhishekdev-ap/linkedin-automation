# ============================================================================
# LinkedIn Automation Tool - Environment Configuration
# ============================================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your credentials and customize settings
# 3. Never commit .env to version control (it's in .gitignore)
#
# ============================================================================

# ----------------------------------------------------------------------------
# LINKEDIN CREDENTIALS (Required)
# ----------------------------------------------------------------------------
# Your LinkedIn account credentials for authentication
# 
# Format: Valid email address
# Example: john.doe@gmail.com
LINKEDIN_EMAIL=your_email@example.com

# Format: Your LinkedIn password (keep secure, never share!)
# Example: MySecurePassword123
LINKEDIN_PASSWORD=your_password

# ----------------------------------------------------------------------------
# BROWSER CONFIGURATION
# ----------------------------------------------------------------------------
# Controls how the browser automation runs

# HEADLESS: Run browser without visible window
# Format: true | false
# - true  = Browser runs invisibly (faster, for production)
# - false = Browser window visible (recommended for debugging)
# Default: false
HEADLESS=false

# BROWSER_PATH: Custom path to Chrome/Chromium executable
# Format: Absolute file path or leave empty for auto-detection
# Example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Default: (empty - auto-detects installed browser)
BROWSER_PATH=

# ----------------------------------------------------------------------------
# DEBUGGING OPTIONS
# ----------------------------------------------------------------------------
# Settings for development and troubleshooting

# DEBUG: Enable verbose debug logging
# Format: true | false
# - true  = Shows detailed logs (timing, selectors, actions)
# - false = Shows only essential logs (info, errors)
# Default: false
DEBUG=false

# SCREENSHOT_ON_ERROR: Capture screenshot when errors occur
# Format: true | false
# Useful for debugging failed automations
# Default: true
SCREENSHOT_ON_ERROR=true

# ----------------------------------------------------------------------------
# STEALTH CONFIGURATION
# ----------------------------------------------------------------------------
# Controls anti-detection timing and behavior

# MIN_DELAY_MS: Minimum delay between actions (milliseconds)
# Format: Integer (100-5000 recommended)
# Lower = faster but more detectable
# Default: 500
MIN_DELAY_MS=500

# MAX_DELAY_MS: Maximum delay between actions (milliseconds)
# Format: Integer (1000-10000 recommended)
# Higher = more human-like but slower
# Default: 3000
MAX_DELAY_MS=3000

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# Prevents account detection by limiting actions per time period
# LinkedIn monitors excessive activity - stay within these limits!

# DAILY_CONNECTION_LIMIT: Maximum connection requests per day
# Format: Integer (recommended: 20-50)
# LinkedIn's unofficial limit is ~100/day, but stay lower to be safe
# Default: 50
DAILY_CONNECTION_LIMIT=50

# HOURLY_CONNECTION_LIMIT: Maximum connection requests per hour
# Format: Integer (recommended: 5-15)
# Spreading requests over time appears more natural
# Default: 10
HOURLY_CONNECTION_LIMIT=10

# DAILY_MESSAGE_LIMIT: Maximum messages sent per day
# Format: Integer (recommended: 50-100)
# Default: 100
DAILY_MESSAGE_LIMIT=100

# ----------------------------------------------------------------------------
# SESSION MANAGEMENT
# ----------------------------------------------------------------------------
# Controls session persistence for faster subsequent logins

# SESSION_FILE: Path to store session cookies
# Format: File path (relative or absolute)
# The file stores encrypted cookies to skip login next time
# Default: .session.json
SESSION_FILE=.session.json

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# SQLite database for storing profiles, requests, and activity logs

# DB_PATH: Path to SQLite database file
# Format: File path (relative or absolute)
# Stores: profiles, connection_requests, messages, activity_log
# Default: linkedin_automation.db
DB_PATH=linkedin_automation.db

# ============================================================================
# OPTIONAL: SCHEDULING (Advanced)
# ============================================================================
# Uncomment to enable activity scheduling (run only during work hours)

# SCHEDULE_ENABLED=true
# SCHEDULE_START_HOUR=9      # Start time (24-hour format, e.g., 9 = 9 AM)
# SCHEDULE_END_HOUR=18       # End time (24-hour format, e.g., 18 = 6 PM)
# SCHEDULE_TIMEZONE=Asia/Kolkata  # Your timezone

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
